# ─────────────────────────────────────────────────────────────
# SEO Model — environment variables
# Copy to `.env` for local development. NEVER commit real values.
# Set the same variables in Vercel: Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# REQUIRED. PostgreSQL connection string.
# Local: postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Production: create a Neon (or other Vercel-compatible) database and paste its
# pooled connection string with `sslmode=require`.
DATABASE_URL=

# REQUIRED for sign-in and for encrypting stored Google OAuth tokens.
# Generate with: openssl rand -base64 48   (must be at least 32 characters)
AUTH_SECRET=

# Public base URL of the deployed app, e.g. https://seo-model.vercel.app (optional locally).
APP_URL=http://localhost:3000

# OPTIONAL — Google Search Console integration.
# Create an OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials
# Enable the "Google Search Console API" for the project.
# Authorized redirect URI must exactly equal GOOGLE_REDIRECT_URI, e.g.
#   http://localhost:3000/api/integrations/google/callback
#   https://<your-domain>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# OPTIONAL — PageSpeed Insights API key.
# Create at https://console.cloud.google.com/apis/library/pagespeedonline.googleapis.com
PAGESPEED_API_KEY=

# REQUIRED for scheduled monitoring. Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# OPTIONAL — AI analysis (OpenAI-compatible key used by @ai-sdk/openai).
# Create at https://platform.openai.com/api-keys
AI_PROVIDER_API_KEY=
# Optional model override (default: gpt-4o-mini)
AI_MODEL=gpt-4o-mini

# OPTIONAL — Transactional email via Resend (https://resend.com/api-keys).
# Required for: email verification, password reset, alert-recipient confirmation, incident emails.
# Without these, the app shows "email not configured" and never claims an email was sent.
# EMAIL_FROM must be a sender on a domain verified in Resend (SPF and DKIM records).
EMAIL_PROVIDER_API_KEY=
# Verified sender, e.g. "SEO Model <alerts@yourdomain.com>"
EMAIL_FROM=

# OPTIONAL — Licensed SERP provider for competitor discovery and keyword suggestions.
# SerpApi (https://serpapi.com/manage-api-key). Results are stored with provenance.
# If unset, competitor discovery is shown as "connection required" (CSV import still works).
SERP_API_KEY=
